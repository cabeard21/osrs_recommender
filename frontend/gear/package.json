{
  "name": "runic-ledger-gear-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e/*.ts *.ts *.json index.html",
    "check": "tsc -b && prettier --check src e2e/*.ts *.ts *.json index.html"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "playwright-core": "1.62.0"
  }
