__pycache__/
*.py[cod]
# Optional desktop native experiment; source .pyx/.pxd files remain tracked.
/tracker/gear/native/*.pyd
/tracker/gear/native/*.so
/tracker/gear/native/*.cpp
*.db
# SQLite's write-ahead log and shared-memory sidecars. `*.db` does not cover them —
# the suffix comes after the extension — so they were tracked, and a file the engine
# rewrites on every run turned each test run into a dirty working tree.
*.db-shm
*.db-wal
*.db-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite.compact-shm
*.sqlite.compact-wal
*.sqlite3
.venv/
.venv-*/
.pytest_tmp*/
/.pytest-*/
/.pytest_browser_tmp*/
.tmp/
/.tmp-*/
/.playwright-mcp/
secrets/
*.env
!*.env.example
.env
config.yaml
config.gear-desktop.yaml
# Agent worktrees. These are live checkouts of other branches; committing them or
# letting the linters walk into them would mix another unit's work into this one's.
.claude/
plugin/build/
spike/*/build/
.gradle/
.pytest_cache/
backups/
.mypy_cache/
.ruff_cache/
.coverage
.coverage-*
htmlcov/
*.egg-info/
credentials.properties
snapshot.json
# Cygwin/MSYS crash dumps. A crashed shell drops these into the repo root; they are
# machine-local debris, not a record of anything the project needs.
*.stackdump

# React Gear preview (build locally with npm run build)
frontend/gear/node_modules/
frontend/gear/test-results/
frontend/gear/playwright-report/
frontend/gear/coverage/
tracker/ui/gear_static/
*.tsbuildinfo

# Local native release identity, generated with the extension binaries.
/tracker/gear/native/_build.json
